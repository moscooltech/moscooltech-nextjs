{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moscooltech",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },
  // KV backs the ISR/data cache (vinext kv-data-adapter). Create with:
  //   npx wrangler kv namespace create VINEXT_KV_CACHE
  // and paste the id below. Local dev builds a throwaway namespace.
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "d6148e891ef04046868229bcb63600e2"
    }
  ],
  // D1 holds all application data. Create with:
  //   npx wrangler d1 create moscooltech-db
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moscooltech-db",
      "database_id": "e01f96c8-b920-48b3-a721-7fac663e979d",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI powers the content studio. The binding itself is free; inference
  // is billed in Neurons and the Free plan includes a daily allocation.
  "ai": {
    "binding": "AI"
  },
  // No "triggers" block: vinext does not expose a scheduled() handler, so a
  // Cloudflare Cron Trigger would invoke a function that does not exist.
  // Drive the jobs over HTTP instead (POST /api/cron?job=… with x-cron-secret),
  // from cron-job.org, UptimeRobot or a GitHub Action. See README → Automation.
  "vars": {
    "SITE_URL": "https://moscooltech.dayotunde25.workers.dev",
    "BUSINESS_ADDRESS": "16, Oredegbe Street, Off Ogundele Street, Agbado Station",
    "BUSINESS_LOCALITY": "Ifo",
    "BUSINESS_REGION": "Ogun State",
    "BUSINESS_PHONE": "+2349033150460",
    "BUSINESS_EMAIL": "dayotunde25@gmail.com",
    "GOOGLE_REVIEW_URL": "https://www.google.com/maps/search/?api=1&query=Moscool+Technical+Services+16+Oredegbe+Street+Agbado+Station+Ifo+Ogun+State",
    "AI_PROVIDER": "workers-ai",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "observability": {
    "enabled": true
  }
}
